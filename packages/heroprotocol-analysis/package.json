{
  "name": "@myrddraall/heroprotocol-analysis",
  "version": "0.0.0-MAIN",
  "description": "Built-in analysers over the heroprotocol-db replay model, and the batteries-included ingest worker",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "worker": [
        "./dist/worker.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "format": "prettier --write \"{src,test,tools}/**/*.{ts,mts}\"",
    "github.actions.build": "pnpm build",
    "github.actions.pack": "gitflow pack",
    "github.actions.test": "pnpm test",
    "goldens:generate": "tsx tools/generate-goldens.mts",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@myrddraall/heroprotocol-db": "workspace:*"
  },
  "devDependencies": {
    "@myrddraall/heroprotocol": "workspace:*",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "dexie": "^4.4.6",
    "eslint": "^9.18.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "dexie": "^4.4.6"
  },
  "keywords": [
    "analysis",
    "heroes-of-the-storm",
    "heroprotocol",
    "replay",
    "stormreplay",
    "web-worker"
  ],
  "author": "Myrddraall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myrddraall/heroprotocol.git",
    "directory": "packages/heroprotocol-analysis"
  },
  "bugs": "https://github.com/myrddraall/heroprotocol/issues",
  "homepage": "https://github.com/myrddraall/heroprotocol#readme",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "module": "./dist/index.js",
  "sideEffects": [
    "./dist/worker.js"
  ],
  "type": "module"
}
