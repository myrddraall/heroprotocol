{
  "name": "@myrddraall/hero-data",
  "version": "0.0.0-MAIN",
  "description": "Hero, talent, ability and award names for Heroes of the Storm replays — an injectable provider with an implementation over HeroesToolChest/heroes-data",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "builds:generate": "tsx tools/generate-builds.mts",
    "format": "prettier --write \"{src,test,tools}/**/*.{ts,mts}\"",
    "github.actions.build": "pnpm build",
    "github.actions.pack": "gitflow pack",
    "github.actions.test": "pnpm test",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "heroes-of-the-storm",
    "heroes-data",
    "heroprotocol",
    "replay",
    "talents"
  ],
  "author": "Myrddraall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myrddraall/heroprotocol.git",
    "directory": "packages/hero-data"
  },
  "bugs": "https://github.com/myrddraall/heroprotocol/issues",
  "homepage": "https://github.com/myrddraall/heroprotocol#readme",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "module": "./dist/index.js",
  "sideEffects": false,
  "type": "module"
}
